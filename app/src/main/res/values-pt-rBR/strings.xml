    <string name="network_smb_form_status_error_format">✗ Falha: %1$s</string>

    <!-- Plural: T8.5 / nota do doc — resultado de smb_list_shares ao testar um
         servidor ("N share(s) encontrado(s)"). O portugues so tem
         "one"/"other" (sem "zero"/"few"/"many" como em outras linguas). -->
    <plurals name="network_smb_form_status_connected">
        <item quantity="one">✓ Conectado (%1$d share encontrado)</item>
        <item quantity="other">✓ Conectado (%1$d shares encontrados)</item>
    </plurals>

    <!-- Rede: navegacao de diretorio SMB (VRPresentation.renderNetworkFiles / loadNetworkDirectory) -->
    <string name="network_files_loading">Carregando...</string>
    <string name="network_files_empty">(vazio)</string>

