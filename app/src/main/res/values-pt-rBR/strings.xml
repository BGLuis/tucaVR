    <string name="network_url_status_not_seekable">⚠ Servidor NAO suporta seek (Accept-Ranges ausente)</string>

    <!-- Rede: aba SMB — lista de servidores salvos (VRPresentation.buildNetworkSmbPage) -->
    <string name="network_smb_saved_servers_header">Servidores salvos</string>
    <string name="network_smb_empty">(nenhum servidor salvo)</string>
