    <string name="browser_label_size_mb_format">%1$.1f MB</string>
    <string name="browser_label_size_gb_format">%1$.2f GB</string>

    <!-- Rede: landing com abas URL / SMB (VRPresentation.renderNetworkHome) -->
    <string name="network_title">Rede</string>
    <string name="network_tab_url">🔗 URL</string>
    <string name="network_tab_smb">🗄 SMB</string>

    <!-- Rede: aba URL (VRPresentation.buildNetworkUrlPage) -->
    <string name="network_url_hint">http:// ou https://...</string>
