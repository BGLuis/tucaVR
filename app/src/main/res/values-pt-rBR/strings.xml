<?xml version="1.0" encoding="utf-8"?>
<!--
  T8.2: Portugues (BR) — lingua original em que a UI do app foi escrita
  (literais que estavam hardcoded em Kotlin ate esta sessao). Ver
  values/strings.xml (ingles/default) para a convencao de naming (T8.3) e
  notas gerais. As chaves e a ORDEM aqui espelham exatamente o arquivo
  default, pra facilitar diff/revisao lado a lado.
-->
<resources>

    <!-- App -->
    <string name="app_name">VR Player</string>

    <!-- Comum / reusado entre telas (VoidPanelChrome, listagens de arquivo) -->
    <string name="common_btn_back">‹ Voltar</string>
    <string name="common_warning_format">⚠ %1$s</string>
    <string name="common_row_dir_format">📁 %1$s</string>
    <string name="common_row_video_format">🎬 %1$s</string>

    <!-- Home (VRPresentation.renderHome) -->
    <string name="home_title">VR Player</string>
    <string name="home_btn_local_files">📁  Arquivos locais</string>
    <string name="home_btn_network">🌐  Rede</string>
    <string name="home_btn_continue_watching">▶  Continuar assistindo</string>

