<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Never extract Tink keysets or encrypted network credentials via cloud backup or device transfer. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="server_credentials_encrypted.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="server_credentials_encrypted.xml" />
    </device-transfer>
</data-extraction-rules>
