<?xml version="1.0" encoding="utf-8"?>
<!--
  O `package="..."` que existia aqui foi removido: com AGP 8 o application id
  vem exclusivamente de `namespace`/`applicationId` no app/build.gradle.kts
  (`com.tucavr`), e manter os dois lados duplicados so cria a chance de eles
  divergirem numa proxima migracao de nome.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Teclado nativo do Meta Quest (VRActivity.showNativeKeyboardFor):
         diz ao Horizon OS que este app quer o teclado do sistema exibido
         como overlay 3D quando um EditText real (nao numa VirtualDisplay)
         ganha foco/IME — ver amostra oficial
         sdk/meta-openxr-sdk/Samples/XrSamples/XrOverlayKeyboard. required=false
         pra nao impedir instalacao em versoes do Horizon OS sem o recurso
         (o app so perderia o overlay automatico nesse caso, nao quebraria). -->
    <uses-feature android:name="oculus.software.overlay_keyboard" android:required="false" />

    <!-- Fase 0.3 Seção 2: Passthrough / Mixed Reality (XR_FB_passthrough).
         required=false pelo mesmo motivo do overlay_keyboard acima: o app
         continua instalando/funcionando em runtimes sem o recurso; o botão
         de passthrough na UI só sai de DISABLED quando o C++ confirma que a
         extensão existe (ver AppState::supportsPassthrough em
         vr_player_app_vulkan.cpp e get_passthrough_supported no bridge). -->
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />

    <!-- Obrigatório para apps de Realidade Virtual Imersiva (6DoF) -->
    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
    <!-- Suporte a Hand Tracking / Permite lançamento mesmo quando controles Touch estiverem em standby -->
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true">

        <!-- Dispositivos suportados e tela de carregamento nativa -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s" />
        <meta-data android:name="com.oculus.ossplash" android:value="true" />
        <meta-data android:name="com.oculus.handtracking.version" android:value="V2.0" />

        <!-- `excludeFromRecents="true"` e exigencia documentada da Meta pra
             activity de lancamento de app imersivo ("Application Manifests for
             Release Builds"), e faltava aqui. Sem ela a task do app entra na
             lista de recents do Android — que, num app `vr_only` sem nenhuma
             janela 2D e sem TaskDescription, e justamente a superficie que o
             Horizon OS acaba desenhando sem nome/thumbnail ao sair do app.
             Ver tambem `setTaskDescription` no onCreate da VRActivity, que
             carimba nome+icone na task pra qualquer superficie que os leia. -->
        <activity
            android:name=".VRActivity"
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false">
            <meta-data android:name="android.app.lib_name" android:value="vrplayer_native" />
            <meta-data android:name="com.oculus.vr.mode" android:value="vr_only" />
            <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>

</manifest>
